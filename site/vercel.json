{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "newzerocloude.vercel.app"
        }
      ],
      "destination": "https://zero-one9.vercel.app/",
      "permanent": true
    },
    {
      "source": "/site/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "newzerocloude.vercel.app"
        }
      ],
      "destination": "https://zero-one9.vercel.app/:path*",
      "permanent": true
    }
  ]
}